<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>15.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Jint JS 引擎：drpy2 爬虫运行时（与猫爪音乐同版本，Acornima 显式锁定） -->
    <PackageReference Include="Jint" Version="4.16.0" />
    <PackageReference Include="Acornima" Version="1.7.0" />
    <!-- TVBox JS Spider：DOM 规则解析（pd/pdfh/pdfa 的 CSS 选择器执行） -->
    <PackageReference Include="AngleSharp" Version="1.1.2" />
    <!-- BT 流式引擎：磁力边下边播（纯托管，Android/Windows 同库；流式模式 2.0 起官方内建） -->
  </ItemGroup>

  <ItemGroup>
    <!-- 猫爪家族共享库（与 CatClawMusic 共用）：JsRuntimeServiceBase 等纯 C# 共享实现。
         接口（IJsRuntimeService 等）仍保留在本项目内。 -->
    <ProjectReference Include="..\..\CatClaw.Shared\src\CatClaw.Shared.Core\CatClaw.Shared.Core.csproj" />
  </ItemGroup>
</Project>
