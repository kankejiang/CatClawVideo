<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CatClawVideo.Maui.Controls"
             x:Class="CatClawVideo.Maui.Pages.WatchPage"
             BackgroundColor="{DynamicResource WindowBackgroundColor}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,14,24,28" Spacing="14">

            <!-- 顶栏：返回 + 品牌（延续顶部导航视觉） -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="{DynamicResource ChipInactiveColor}"
                        StrokeShape="RoundRectangle 12" WidthRequest="38" HeightRequest="38">
                    <Label Text="←" FontSize="20" TextColor="{DynamicResource TextPrimaryColor}"
                           HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                </Border>
                <Label Grid.Column="1" Text="猫爪影视" FontSize="14.5" FontFamily="OpenSansSemibold"
                       TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="Center" />
                <Button Grid.Column="3" Text="⛶ 全屏播放" FontSize="12" TextColor="White"
                        BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}"
                        CornerRadius="8" Padding="12,5" Clicked="OnPlayFullClicked" />
            </Grid>

            <!-- 上区：小窗播放器（58%）+ 信息面板（42%） -->
            <Grid ColumnDefinitions="58*,42*" ColumnSpacing="18">

                <!-- 小窗播放器（16:9，高度随宽度自适应）+ 控制条 -->
                <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="Black"
                        VerticalOptions="Start">
                    <Grid x:Name="PlayerHost" HeightRequest="340">
                        <controls:VideoPlayerView x:Name="Player"
                                                  Aspect="AspectFit"
                                                  ShouldKeepScreenOn="True" />

                        <Grid x:Name="BufferingIndicator" IsVisible="False">
                            <ActivityIndicator IsRunning="True" Color="{DynamicResource PrimaryColor}"
                                               WidthRequest="40" HeightRequest="40"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>

                        <!-- 控制覆盖层：中央播放/暂停 + 底部进度 -->
                        <Grid x:Name="ControlsOverlay">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSurfaceTapped" />
                            </Grid.GestureRecognizers>
                            <ImageButton x:Name="CenterPlayButton"
                                         WidthRequest="56" HeightRequest="56"
                                         CornerRadius="28"
                                         BackgroundColor="#66000000"
                                         HorizontalOptions="Center" VerticalOptions="Center"
                                         Clicked="OnPlayPauseClicked" />
                            <Grid VerticalOptions="End"
                                  ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"
                                  Padding="12,6,12,10"
                                  BackgroundColor="#99000000">
                                <Label Grid.Column="0" x:Name="PositionLabel" Text="00:00"
                                       FontSize="10.5" FontFamily="OpenSansSemibold" TextColor="White"
                                       VerticalOptions="Center" />
                                <Slider Grid.Column="1" x:Name="ProgressBar"
                                        Minimum="0" Maximum="100" Value="0"
                                        MinimumTrackColor="{DynamicResource PrimaryColor}"
                                        MaximumTrackColor="#40FFFFFF" ThumbColor="White"
                                        VerticalOptions="Center"
                                        DragStarted="OnSeekStarted" DragCompleted="OnSeekCompleted" />
                                <Label Grid.Column="2" x:Name="DurationLabel" Text="--:--"
                                       FontSize="10.5" FontFamily="OpenSansSemibold" TextColor="White"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 信息面板 -->
                <VerticalStackLayout Grid.Column="1" Spacing="0">
                    <Label x:Name="TitleLabel" FontSize="21" FontFamily="OpenSansSemibold"
                           LineBreakMode="TailTruncation" MaxLines="2"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <Label x:Name="MetaLabel" FontSize="12.5" Margin="0,8,0,0"
                           TextColor="{DynamicResource TextSecondaryColor}" />
                    <Label x:Name="DescLabel" FontSize="12.5" LineHeight="19" Margin="0,10,0,0"
                           TextColor="{DynamicResource TextSecondaryColor}" />
                    <Label Text="播放线路" FontSize="13.5" FontFamily="OpenSansSemibold" Margin="0,16,0,0"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <HorizontalStackLayout x:Name="LinesHost" Spacing="8" Margin="0,8,0,0" />
                    <HorizontalStackLayout Spacing="10" Margin="0,14,0,0">
                        <Button Text="♥ 收藏" FontSize="12.5"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                BackgroundColor="{DynamicResource ChipInactiveColor}"
                                CornerRadius="8" Padding="16,7" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <!-- 选集 -->
            <Label Text="选集" FontSize="13.5" FontFamily="OpenSansSemibold" Margin="0,10,0,0"
                   TextColor="{DynamicResource TextPrimaryColor}" />
            <CollectionView x:Name="EpisodeGrid" SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="9" VerticalItemSpacing="8" HorizontalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                BackgroundColor="{DynamicResource ChipInactiveColor}" Padding="0,8">
                            <Label Text="{Binding Name}" FontSize="12" HorizontalTextAlignment="Center"
                                   MaxLines="1" LineBreakMode="TailTruncation"
                                   TextColor="{DynamicResource TextSecondaryColor}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 相关推荐占位（接入推荐接口后填充） -->
            <Label Text="相关推荐随后续推荐接口上线" FontSize="11" Margin="0,14,0,0"
                   TextColor="{DynamicResource TextHintColor}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
