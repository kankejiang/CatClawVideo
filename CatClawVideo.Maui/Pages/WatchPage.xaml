<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CatClawVideo.Maui.Controls"
             x:Class="CatClawVideo.Maui.Pages.WatchPage"
             BackgroundColor="{DynamicResource WindowBackgroundColor}"
             NavigationPage.HasNavigationBar="False">

    <!-- 隐藏 Shell 系统返回键（页面自带自定义返回，避免左上角双返回按钮） -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Padding="24,14,24,28" Spacing="14">

            <!-- 顶栏：返回 + 品牌（全屏按钮在播放器控制条内，避开窗口控件区） -->
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12">
                <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="{DynamicResource ChipInactiveColor}"
                        StrokeShape="RoundRectangle 12" WidthRequest="38" HeightRequest="38">
                    <Label Text="←" FontSize="20" TextColor="{DynamicResource TextPrimaryColor}"
                           HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                </Border>
                <Label Grid.Column="1" Text="猫爪影视" FontSize="14.5" FontFamily="OpenSansSemibold"
                       TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="Center" />
            </Grid>

            <!-- ═══ 主区：播放器 + 右侧选集栏（主流播放器形态） ═══ -->
            <Grid ColumnDefinitions="*,300" ColumnSpacing="16">

                <!-- 播放器（16:9 高度随宽自适应）+ 线路芯片 + 控制条 -->
                <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="Black"
                        VerticalOptions="Start">
                    <Grid x:Name="PlayerHost" HeightRequest="340">
                        <controls:VideoPlayerView x:Name="Player"
                                                  Aspect="AspectFit"
                                                  ShouldKeepScreenOn="True" />

                        <!-- 线路芯片（左上角内嵌） -->
                        <HorizontalStackLayout x:Name="LinesHost" Spacing="6"
                                               Margin="12,10,12,0" VerticalOptions="Start" />

                        <Grid x:Name="BufferingIndicator" IsVisible="False">
                            <ActivityIndicator IsRunning="True" Color="{DynamicResource PrimaryColor}"
                                               WidthRequest="40" HeightRequest="40"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>

                        <!-- 控制覆盖层：中央播放/暂停 + 底部进度 -->
                        <Grid x:Name="ControlsOverlay">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSurfaceTapped" />
                            </Grid.GestureRecognizers>
                            <ImageButton x:Name="CenterPlayButton"
                                         WidthRequest="56" HeightRequest="56"
                                         CornerRadius="28"
                                         BackgroundColor="#66000000"
                                         HorizontalOptions="Center" VerticalOptions="Center"
                                         Clicked="OnPlayPauseClicked" />
                            <Grid VerticalOptions="End"
                                  ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="12"
                                  Padding="12,6,12,10"
                                  BackgroundColor="#99000000">
                                <ImageButton Grid.Column="0" x:Name="SmallPlayButton"
                                             Source="ic_pause.svg"
                                             WidthRequest="20" HeightRequest="20"
                                             BackgroundColor="Transparent"
                                             VerticalOptions="Center"
                                             Clicked="OnPlayPauseClicked" />
                                <Label Grid.Column="1" x:Name="PositionLabel" Text="00:00"
                                       FontSize="10.5" FontFamily="OpenSansSemibold" TextColor="White"
                                       VerticalOptions="Center" />
                                <Slider Grid.Column="2" x:Name="ProgressBar"
                                        Minimum="0" Maximum="100" Value="0"
                                        MinimumTrackColor="{DynamicResource PrimaryColor}"
                                        MaximumTrackColor="#40FFFFFF" ThumbColor="White"
                                        VerticalOptions="Center"
                                        DragStarted="OnSeekStarted" DragCompleted="OnSeekCompleted" />
                                <Label Grid.Column="3" x:Name="DurationLabel" Text="--:--"
                                       FontSize="10.5" FontFamily="OpenSansSemibold" TextColor="White"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="4" Text="⛶" FontSize="15" Padding="0"
                                        WidthRequest="30" HeightRequest="26"
                                        TextColor="White" BackgroundColor="Transparent"
                                        VerticalOptions="Center"
                                        Clicked="OnPlayFullClicked" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 右侧选集栏（与播放器等高，内部滚动） -->
                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                        VerticalOptions="Fill" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,*" Padding="0">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="14,12,14,0">
                            <Label Grid.Column="0" Text="选集" FontSize="14" FontFamily="OpenSansSemibold"
                                   TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="EpisodeCountLabel" FontSize="11"
                                   TextColor="{DynamicResource TextHintColor}" VerticalOptions="Center" />
                        </Grid>
                        <ScrollView Grid.Row="1" Padding="10,8,10,12">
                            <VerticalStackLayout x:Name="EpisodeListHost" Spacing="4" />
                        </ScrollView>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ 信息区（播放器下方全宽） ═══ -->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="0" Padding="0,2,0,0">
                <!-- 标题行：片名 + 徽章 + 操作 -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0" x:Name="TitleLabel" FontSize="20" FontFamily="OpenSansSemibold"
                           LineBreakMode="TailTruncation" MaxLines="1"
                           TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="Center" />
                    <Border Grid.Column="1" x:Name="RemarksBadge" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                            BackgroundColor="{DynamicResource ChipInactiveColor}" Padding="8,3" IsVisible="False"
                            VerticalOptions="Center">
                        <Label x:Name="RemarksBadgeLabel" FontSize="11" TextColor="#FFD76E" />
                    </Border>
                    <Border Grid.Column="2" x:Name="YearBadge" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                            BackgroundColor="{DynamicResource ChipInactiveColor}" Padding="8,3" IsVisible="False"
                            VerticalOptions="Center">
                        <Label x:Name="YearBadgeLabel" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Border>
                    <Border Grid.Column="3" x:Name="CategoryBadge" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                            BackgroundColor="{DynamicResource ChipInactiveColor}" Padding="8,3" IsVisible="False"
                            VerticalOptions="Center">
                        <Label x:Name="CategoryBadgeLabel" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Border>
                    <Button Grid.Column="5" Text="♥ 收藏" FontSize="12.5"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            BackgroundColor="{DynamicResource ChipInactiveColor}"
                            CornerRadius="8" Padding="16,7" Clicked="OnFavoriteClicked" />
                    <Button Grid.Column="6" Text="⇪ 分享" FontSize="12.5"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            BackgroundColor="{DynamicResource ChipInactiveColor}"
                            CornerRadius="8" Padding="16,7" Clicked="OnShareClicked" />
                </Grid>

                <!-- 元数据行 -->
                <Label Grid.Row="1" x:Name="MetaLabel" FontSize="12" Margin="0,8,0,0"
                       TextColor="{DynamicResource TextHintColor}" />

                <!-- 简介（两行截断 + 展开） -->
                <Label Grid.Row="2" x:Name="DescLabel" FontSize="12.5" Margin="0,10,0,0"
                       LineBreakMode="WordWrap" MaxLines="2"
                       TextColor="{DynamicResource TextSecondaryColor}" />
                <Label Grid.Row="3" x:Name="DescToggle" Text="展开 ▾" FontSize="12"
                       TextColor="{DynamicResource PrimaryColor}" Margin="0,6,0,0" IsVisible="False">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDescToggleTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- 相关推荐占位（接入推荐接口后填充） -->
            <Label Text="相关推荐随后续推荐接口上线" FontSize="11" Margin="0,14,0,0"
                   TextColor="{DynamicResource TextHintColor}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
