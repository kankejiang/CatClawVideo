<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawVideo.Maui.Pages.SearchPage"
             BackgroundColor="{DynamicResource WindowBackgroundColor}"
             NavigationPage.HasNavigationBar="False">

    <!-- 隐藏 Shell 系统返回键（页面自带自定义返回，避免左上角双返回按钮，同 WatchPage） -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Padding="24,14,24,28" Spacing="12">

            <!-- 顶栏：返回 + 搜索框 -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="{DynamicResource ChipInactiveColor}"
                        StrokeShape="RoundRectangle 12" WidthRequest="38" HeightRequest="38">
                    <Image Source="ic_back.svg" WidthRequest="18" HeightRequest="18"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                </Border>
                <Entry Grid.Column="1" x:Name="SearchEntry"
                       Placeholder="搜索影片 / 演员…"
                       PlaceholderColor="{DynamicResource TextHintColor}"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       ReturnType="Search" ReturnCommand="{Binding SearchCommand}"
                       VerticalOptions="Center" />
                <Button Grid.Column="2" Text="搜索" FontSize="12.5" TextColor="White"
                        BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}"
                        CornerRadius="8" Padding="16,6"
                        Command="{Binding SearchCommand}" VerticalOptions="Center" />
            </Grid>

            <!-- 热门搜索（豆瓣热门片单标题，结果为空时显示） -->
            <VerticalStackLayout x:Name="HotSection" Spacing="10" Margin="0,10,0,0">
                <Label Text="热门搜索" FontSize="13.5" FontFamily="OpenSansSemibold"
                       TextColor="{DynamicResource TextPrimaryColor}" />
                <Label x:Name="HotStatus" Text="正在加载热搜…" FontSize="12"
                       TextColor="{DynamicResource TextHintColor}" />
                <FlexLayout x:Name="HotWords" Wrap="Wrap" JustifyContent="Start" />
            </VerticalStackLayout>

            <!-- 搜索结果 -->
            <VerticalStackLayout x:Name="ResultSection" Spacing="10" IsVisible="False">
                <Label Text="搜索结果" FontSize="13.5" FontFamily="OpenSansSemibold"
                       TextColor="{DynamicResource TextPrimaryColor}" />
                <Label x:Name="StatusLabel" FontSize="12"
                       TextColor="{DynamicResource TextHintColor}" IsVisible="True" />
                <CollectionView x:Name="ResultGrid" SelectionMode="Single"
                                SelectionChanged="OnResultSelected">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="6" VerticalItemSpacing="16" HorizontalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="0">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{DynamicResource CardBackgroundColor}" HeightRequest="190">
                                    <Grid>
                                        <Image Source="{Binding Cover}" Aspect="AspectFill" />
                                        <Image Source="appiconfg.svg" Aspect="AspectFit" Opacity="0.35"
                                               WidthRequest="38" HeightRequest="38"
                                               HorizontalOptions="Center" VerticalOptions="Center">
                                            <Image.Triggers>
                                                <DataTrigger TargetType="Image" Binding="{Binding Cover}" Value="{x:Null}">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>
                                        <Border HorizontalOptions="End" VerticalOptions="Start" Margin="0,7,7,0"
                                                StrokeThickness="0" BackgroundColor="#80000000" StrokeShape="RoundRectangle 8" Padding="6,1">
                                            <Label Text="{Binding Remarks}" FontSize="10" TextColor="#FFD76E" MaxLines="1" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Label Text="{Binding Title}" FontSize="12.5" Margin="0,7,0,0"
                                       LineBreakMode="TailTruncation" MaxLines="1"
                                       TextColor="{DynamicResource TextPrimaryColor}" />
                                <Label Text="{Binding Year}" FontSize="10.5" Margin="0,2,0,0"
                                       TextColor="{DynamicResource TextHintColor}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
