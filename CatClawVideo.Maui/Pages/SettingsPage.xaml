<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawVideo.Maui.Pages.SettingsPage"
             BackgroundColor="Transparent">

    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,24" Spacing="16">

            <Label Text="设置"
                   FontSize="28"
                   FontFamily="OpenSansSemibold"
                   TextColor="{DynamicResource TextPrimaryColor}"
                   Margin="0,8,0,0" />

            <!-- ═══ 订阅源管理 ═══ -->
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}"
                    Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="订阅源管理" FontSize="16" FontFamily="OpenSansSemibold"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="完整配置 ›" FontSize="12"
                               TextColor="{DynamicResource PrimaryColor}" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenSourceConfig" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Label Text="TVBox / 影视仓订阅地址，支持多仓自动识别；不内置任何源，添加订阅后首页/搜索即用该源"
                           FontSize="12"
                           TextColor="{DynamicResource TextSecondaryColor}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,6,0,0">
                        <Button x:Name="ImportFileButton" Grid.Column="0" Text="📂 文件" FontSize="12.5" TextColor="White"
                                BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}" CornerRadius="8" Padding="14,6"
                                Clicked="OnImportFileClicked" />
                        <Entry x:Name="SubEntry" Grid.Column="1" Placeholder="粘贴订阅地址（TVBox json / 影视仓多仓 / 猫爪源）…"
                               PlaceholderColor="{DynamicResource TextHintColor}"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Button x:Name="AddSubButton" Grid.Column="2" Text="＋ 添加" FontSize="12.5" TextColor="White"
                                BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}" CornerRadius="8" Padding="16,6"
                                Clicked="OnAddSubClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ═══ 手机解析节点（PC 端：填手机地址）═══ -->
            <Border x:Name="NodeClientCard" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}"
                    Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="手机解析节点" FontSize="16" FontFamily="OpenSansSemibold"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <Label Text="本机跑不了 Guard 加固源（解密器是安卓 ARM 原生库，且解密产物写完即删）。让手机当解析节点：手机只做取页+解析的轻活（不发烫），播放仍在本机。手机端保持 App 在前台即可，地址形如 http://192.168.x.x:8899。"
                           FontSize="12" LineBreakMode="WordWrap"
                           TextColor="{DynamicResource TextSecondaryColor}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry x:Name="NodeEntry" Grid.Column="0"
                               Placeholder="http://192.168.x.x:8899"
                               PlaceholderColor="{DynamicResource TextHintColor}"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Button x:Name="NodeTestButton" Grid.Column="1" Text="测试" FontSize="12.5"
                                TextColor="White" BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}"
                                CornerRadius="8" Padding="18,6" Clicked="OnTestNodeClicked" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <Entry x:Name="NodeTokenEntry" Grid.Column="0"
                               Placeholder="口令（手机端日志/二维码里显示，可留空）"
                               PlaceholderColor="{DynamicResource TextHintColor}"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Button Grid.Column="1" Text="保存" FontSize="12.5"
                                TextColor="White" BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}"
                                CornerRadius="8" Padding="18,6" Clicked="OnSaveNodeClicked" />
                        <Button Grid.Column="2" Text="清除" FontSize="12.5"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                BackgroundColor="Transparent" BorderWidth="1"
                                BorderColor="{DynamicResource DividerColor}"
                                CornerRadius="8" Padding="18,6" Clicked="OnClearNodeClicked" />
                    </Grid>
                    <Label x:Name="NodeStatusLabel" Text="" FontSize="12" LineBreakMode="WordWrap"
                           TextColor="{DynamicResource TextSecondaryColor}" />
                </VerticalStackLayout>
            </Border>

            <!-- ═══ 本机作为解析节点（手机端：给自己用，也供 PC 扫码配对）═══ -->
            <Border x:Name="NodeHostCard" IsVisible="False" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}"
                    Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="本机作为解析节点" FontSize="16" FontFamily="OpenSansSemibold"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <Label Text="本机已在局域网内提供解析服务，供 PC 端借用（PC 跑不了 Guard 加固源）。本机只做取页+解析的轻活，不发烫。"
                           FontSize="12" LineBreakMode="WordWrap"
                           TextColor="{DynamicResource TextSecondaryColor}" />
                    <Image x:Name="NodeQrImage" WidthRequest="150" HeightRequest="150" HorizontalOptions="Center" />
                    <Label x:Name="NodeAddressLabel" Text="" FontSize="12" HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource TextSecondaryColor}" />
                    <Label x:Name="NodeTokenLabel" Text="" FontSize="11.5" HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource TextHintColor}" />

                    <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />

                    <Label Text="配对到电脑（让 PC 自动记住本机）" FontSize="12.5"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry x:Name="PcAddressEntry" Grid.Column="0"
                               Placeholder="电脑上显示的地址，如 192.168.1.5:8900"
                               PlaceholderColor="{DynamicResource TextHintColor}"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Button x:Name="PairButton" Grid.Column="1" Text="配对" FontSize="12.5"
                                TextColor="White" BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}"
                                CornerRadius="8" Padding="18,6" Clicked="OnPairToPcClicked" />
                    </Grid>
                    <Label x:Name="PairStatusLabel" Text="" FontSize="12" LineBreakMode="WordWrap"
                           TextColor="{DynamicResource TextSecondaryColor}" />
                </VerticalStackLayout>
            </Border>

            <!-- ═══ 下载管理 ═══ -->
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}"
                    Padding="20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="下载管理" FontSize="16" FontFamily="OpenSansSemibold"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Text="磁力整包 / HTTP 直链下载，断点续传与并发控制；已完成视频可直接播放"
                               FontSize="12"
                               TextColor="{DynamicResource TextSecondaryColor}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="打开" FontSize="12"
                            HeightRequest="34" CornerRadius="17" Padding="18,0"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            TextColor="White"
                            Clicked="OnOpenDownloads" />
                </Grid>
            </Border>

            <!-- ═══ 播放器 ═══ -->
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}"
                    Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="播放器"
                           FontSize="16"
                           FontFamily="OpenSansSemibold"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="小窗尺寸（21:9 手机横屏）" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="58% 宽 · 可展开全宽" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="默认画面比例" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="保持比例（AspectFit）" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="默认倍速" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="1.0×" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="电视遥控焦点样式" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="白色描边 + 放大" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ═══ 关于 ═══ -->
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}"
                    Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                            StrokeThickness="0" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource CardBackgroundStrongColor}"
                            VerticalOptions="Center">
                        <Image Source="ic_info.png" WidthRequest="22" HeightRequest="22"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="关于" FontSize="16" FontFamily="OpenSansSemibold"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label x:Name="AboutVersionLabel" Text="猫爪影视"
                               FontSize="12" TextColor="{DynamicResource TextHintColor}" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" Source="ic_arrow_right_white.png"
                           WidthRequest="16" HeightRequest="16"
                           VerticalOptions="Center" Opacity="0.4" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAboutClicked" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>

