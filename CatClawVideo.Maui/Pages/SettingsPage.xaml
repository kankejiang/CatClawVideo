<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawVideo.Maui.Pages.SettingsPage"
             BackgroundColor="Transparent">

    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,24" Spacing="16">

            <Label Text="设置"
                   FontSize="28"
                   FontFamily="OpenSansSemibold"
                   TextColor="{DynamicResource TextPrimaryColor}"
                   Margin="0,8,0,0" />

            <!-- ═══ 订阅源管理 ═══ -->
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}"
                    Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="订阅源管理" FontSize="16" FontFamily="OpenSansSemibold"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="完整配置 ›" FontSize="12"
                               TextColor="{DynamicResource PrimaryColor}" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenSourceConfig" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Label Text="TVBox / 影视仓订阅地址，支持多仓自动识别；不内置任何源，添加订阅后首页/搜索即用该源"
                           FontSize="12"
                           TextColor="{DynamicResource TextSecondaryColor}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,6,0,0">
                        <Button x:Name="ImportFileButton" Grid.Column="0" Text="📂 文件" FontSize="12.5" TextColor="White"
                                BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}" CornerRadius="8" Padding="14,6"
                                Clicked="OnImportFileClicked" />
                        <Entry x:Name="SubEntry" Grid.Column="1" Placeholder="粘贴订阅地址（TVBox json / 影视仓多仓 / 猫爪源）…"
                               PlaceholderColor="{DynamicResource TextHintColor}"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Button x:Name="AddSubButton" Grid.Column="2" Text="＋ 添加" FontSize="12.5" TextColor="White"
                                BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}" CornerRadius="8" Padding="16,6"
                                Clicked="OnAddSubClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ═══ 播放器 ═══ -->
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}"
                    Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="播放器"
                           FontSize="16"
                           FontFamily="OpenSansSemibold"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="小窗尺寸（21:9 手机横屏）" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="58% 宽 · 可展开全宽" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="默认画面比例" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="保持比例（AspectFit）" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="默认倍速" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="1.0×" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="电视遥控焦点样式" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="白色描边 + 放大" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ═══ 外观 ═══ -->
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}"
                    Padding="20">
                <VerticalStackLayout Spacing="16">

                    <Label Text="外观"
                           FontSize="16"
                           FontFamily="OpenSansSemibold"
                           TextColor="{DynamicResource TextPrimaryColor}" />

                    <!-- 主题色 -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="主题色"
                               FontSize="13"
                               TextColor="{DynamicResource TextSecondaryColor}" />
                        <HorizontalStackLayout x:Name="ThemeSwatches" Spacing="14" />
                    </VerticalStackLayout>

                    <!-- 深浅模式 -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="深浅模式"
                               FontSize="13"
                               TextColor="{DynamicResource TextSecondaryColor}" />
                        <HorizontalStackLayout x:Name="DarkModeChips" Spacing="10" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- ═══ 关于 ═══ -->
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}"
                    Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="关于"
                           FontSize="16"
                           FontFamily="OpenSansSemibold"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <Label Text="猫爪影视 v0.1.0"
                           FontSize="13"
                           TextColor="{DynamicResource TextSecondaryColor}" />
                    <Label Text="跨平台影视播放器（Android / Windows），后续将兼容 TVBox 单仓源与影视仓多仓源，支持站点订阅、分类浏览、跨站搜索与多线路播放。"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           TextColor="{DynamicResource TextHintColor}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>

