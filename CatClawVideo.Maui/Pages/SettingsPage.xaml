<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawVideo.Maui.Pages.SettingsPage"
             BackgroundColor="Transparent">

    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,24" Spacing="16">

            <Label Text="设置"
                   FontSize="28"
                   FontFamily="OpenSansSemibold"
                   TextColor="{DynamicResource TextPrimaryColor}"
                   Margin="0,8,0,0" />

            <!-- ═══ 订阅源管理 ═══ -->
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}"
                    Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="订阅源管理" FontSize="16" FontFamily="OpenSansSemibold"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="完整配置 ›" FontSize="12"
                               TextColor="{DynamicResource PrimaryColor}" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenSourceConfig" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Label Text="TVBox / 影视仓订阅地址，支持多仓自动识别；不内置任何源，添加订阅后首页/搜索即用该源"
                           FontSize="12"
                           TextColor="{DynamicResource TextSecondaryColor}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,6,0,0">
                        <Button x:Name="ImportFileButton" Grid.Column="0" Text="📂 文件" FontSize="12.5" TextColor="White"
                                BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}" CornerRadius="8" Padding="14,6"
                                Clicked="OnImportFileClicked" />
                        <Entry x:Name="SubEntry" Grid.Column="1" Placeholder="粘贴订阅地址（TVBox json / 影视仓多仓 / 猫爪源）…"
                               PlaceholderColor="{DynamicResource TextHintColor}"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Button x:Name="AddSubButton" Grid.Column="2" Text="＋ 添加" FontSize="12.5" TextColor="White"
                                BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}" CornerRadius="8" Padding="16,6"
                                Clicked="OnAddSubClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ═══ 播放器 ═══ -->
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}"
                    Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="播放器"
                           FontSize="16"
                           FontFamily="OpenSansSemibold"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="小窗尺寸（21:9 手机横屏）" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="58% 宽 · 可展开全宽" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="默认画面比例" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="保持比例（AspectFit）" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="默认倍速" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="1.0×" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="电视遥控焦点样式" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="1" Text="白色描边 + 放大" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Grid>

                    <!-- 磁力缓存上限（2026-09-17 用户要求）：控边下边播的落盘数据量，
                         太小会把刚看过的片段 LRU 掉导致重进又从头下。改完即时生效。 -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                            <Label Text="磁力缓存上限" FontSize="13" TextColor="{DynamicResource TextPrimaryColor}" />
                            <Label Text="边下边播的落盘数据，已看区间重进秒开；超限自动清最旧"
                                   FontSize="11.5" TextColor="{DynamicResource TextSecondaryColor}" />
                        </VerticalStackLayout>
                        <Picker x:Name="CacheCapPicker" Grid.Column="1" WidthRequest="96"
                                FontSize="12.5" TextColor="{DynamicResource TextSecondaryColor}"
                                HorizontalTextAlignment="End"
                                SelectedIndexChanged="OnCacheCapChanged" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ═══ 诊断日志（2026-09-18 用户要求：对齐猫爪音乐，可抓 Debug 级日志）═══ -->
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}"
                    Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                    <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                            StrokeThickness="0" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource CardBackgroundStrongColor}"
                            VerticalOptions="Center">
                        <Image Source="ic_history.png" WidthRequest="22" HeightRequest="22"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="诊断日志" FontSize="16" FontFamily="OpenSansSemibold"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Text="开启后记录 Debug 级运行日志，出问题时导出交开发者排查"
                               FontSize="12" TextColor="{DynamicResource TextHintColor}" />
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDiagnosticLogClicked" />
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>
                    <Switch Grid.Column="2" x:Name="DiagnosticLogSwitch"
                            Toggled="OnDiagnosticLogToggled" VerticalOptions="Center" />
                    <Image Grid.Column="3" Source="ic_arrow_right_white.png"
                           WidthRequest="16" HeightRequest="16"
                           VerticalOptions="Center" Opacity="0.4">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDiagnosticLogClicked" />
                        </Image.GestureRecognizers>
                    </Image>
                </Grid>
            </Border>

            <!-- ═══ 关于 ═══ -->
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}"
                    Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                            StrokeThickness="0" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource CardBackgroundStrongColor}"
                            VerticalOptions="Center">
                        <Image Source="ic_info.png" WidthRequest="22" HeightRequest="22"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="关于" FontSize="16" FontFamily="OpenSansSemibold"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label x:Name="AboutVersionLabel" Text="猫爪影视"
                               FontSize="12" TextColor="{DynamicResource TextHintColor}" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" Source="ic_arrow_right_white.png"
                           WidthRequest="16" HeightRequest="16"
                           VerticalOptions="Center" Opacity="0.4" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAboutClicked" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>

