<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawVideo.Maui.Pages.MainPage"
             BackgroundColor="{DynamicResource WindowBackgroundColor}">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- 顶部导航栏：品牌 + 页面 tabs + 版本（Windows / 安卓横屏共用；电视遥控横向可达） -->
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource TabBarBackgroundColor}"
                Padding="20,0"
                StrokeThickness="0"
                Stroke="{DynamicResource DividerColor}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,140" ColumnSpacing="16" HeightRequest="56">
                <!-- 品牌 -->
                <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                    <Border WidthRequest="26" HeightRequest="26"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 7"
                            BackgroundColor="{DynamicResource PrimaryColor}">
                        <Label Text="🐾" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                    </Border>
                    <Label Text="猫爪影视"
                           FontSize="14.5"
                           FontFamily="OpenSansSemibold"
                           TextColor="{DynamicResource TextPrimaryColor}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- 页面 tabs -->
                <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" x:Name="NavTabs">

                    <Border x:Name="NavBg0" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="16,8">
                        <Label x:Name="NavLabel0" Text="首页" FontSize="13.5" FontFamily="OpenSansSemibold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border x:Name="NavBg1" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="16,8">
                        <Label x:Name="NavLabel1" Text="历史" FontSize="13.5" FontFamily="OpenSansSemibold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border x:Name="NavBg2" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="16,8">
                        <Label x:Name="NavLabel2" Text="收藏" FontSize="13.5" FontFamily="OpenSansSemibold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border x:Name="NavBg3" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="16,8">
                        <Label x:Name="NavLabel3" Text="本地" FontSize="13.5" FontFamily="OpenSansSemibold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border x:Name="NavBg4" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="16,8">
                        <Label x:Name="NavLabel4" Text="设置" FontSize="13.5" FontFamily="OpenSansSemibold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                </HorizontalStackLayout>

                <!-- 搜索入口 -->
                <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="{DynamicResource ChipInactiveColor}"
                        StrokeShape="RoundRectangle 16" Padding="14,8" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="🔍" FontSize="12" VerticalOptions="Center" />
                        <Label Text="搜索影片 / 演员" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTapped" />
                    </Border.GestureRecognizers>
                </Border>



            </Grid>
        </Border>

        <!-- 页面容器：3 个 tab 页，切换时改可见性 -->
        <Grid x:Name="ContentHost" Grid.Row="1" />

    </Grid>

</ContentPage>
