<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawVideo.Maui.Pages.FavoritesPage"
             BackgroundColor="Transparent">

    <!-- 根用 Grid：分组海报墙（最近播放 / 我的收藏）占 * 行获得有界高度 -->
    <Grid RowDefinitions="Auto,*" Padding="24,16,24,20" RowSpacing="12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" Text="我的收藏" FontSize="17" FontFamily="OpenSansSemibold"
                   TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="Center" />
            <Button Grid.Column="1" x:Name="ClearHistoryButton" Text="清空历史" FontSize="12"
                    Padding="14,6" CornerRadius="14"
                    TextColor="{DynamicResource TextSecondaryColor}"
                    BackgroundColor="{DynamicResource ChipInactiveColor}"
                    Command="{Binding ClearHistoryCommand}"
                    IsVisible="False" />
        </Grid>

        <!-- 分组海报墙（真数据：播放历史 + 收藏表；无封面时猫爪前景图标占位） -->
        <CollectionView Grid.Row="1" x:Name="Wall" IsGrouped="True" SelectionMode="Single"
                        SelectionChanged="OnCardSelected">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="6" VerticalItemSpacing="16" HorizontalItemSpacing="14" />
            </CollectionView.ItemsLayout>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Name}" FontSize="15" FontFamily="OpenSansSemibold"
                           Margin="0,6,0,4"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="0">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                BackgroundColor="{DynamicResource CardBackgroundColor}" HeightRequest="190">
                            <Grid>
                                <Image Source="{Binding Cover}" Aspect="AspectFill" />
                                <Image Source="appiconfg.svg" Aspect="AspectFit" Opacity="0.35"
                                       WidthRequest="40" HeightRequest="40"
                                       HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image" Binding="{Binding Cover}" Value="{x:Null}">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                                <Border HorizontalOptions="End" VerticalOptions="Start" Margin="0,7,7,0"
                                        StrokeThickness="0" BackgroundColor="#80000000" StrokeShape="RoundRectangle 8" Padding="6,1"
                                        IsVisible="{Binding HasRemark}">
                                    <Label Text="{Binding Remark}" FontSize="10" TextColor="#FFD76E" MaxLines="1" />
                                </Border>
                            </Grid>
                        </Border>
                        <Label Text="{Binding Title}" FontSize="12.5" Margin="0,7,0,0"
                               LineBreakMode="TailTruncation" MaxLines="1"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Text="{Binding Meta}" FontSize="10.5" Margin="0,2,0,0"
                               LineBreakMode="TailTruncation" MaxLines="1"
                               TextColor="{DynamicResource TextHintColor}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="1" x:Name="EmptyLabel"
               Text="暂无收藏与播放记录，去首页挑一部影片吧"
               FontSize="13" HorizontalTextAlignment="Center" VerticalOptions="Center"
               TextColor="{DynamicResource TextHintColor}" IsVisible="False" />

    </Grid>

</ContentView>
