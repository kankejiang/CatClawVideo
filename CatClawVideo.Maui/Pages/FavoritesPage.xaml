<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawVideo.Maui.Pages.FavoritesPage"
             BackgroundColor="Transparent">

    <!-- 我的收藏海报墙（最近播放归「历史」页，本页只管收藏） -->
    <Grid RowDefinitions="Auto,*" Padding="24,16,24,20" RowSpacing="12">

        <Label Grid.Row="0" Text="我的收藏" FontSize="17" FontFamily="OpenSansSemibold"
               TextColor="{DynamicResource TextPrimaryColor}" />

        <!-- 海报墙（无封面时猫爪前景图标占位） -->
        <CollectionView Grid.Row="1" x:Name="Wall" SelectionMode="Single"
                        SelectionChanged="OnCardSelected">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="6" VerticalItemSpacing="16" HorizontalItemSpacing="14" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="0">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                BackgroundColor="{DynamicResource CardBackgroundColor}"
                                HeightRequest="{DynamicResource PosterCardHeight}"
                                WidthRequest="{DynamicResource PosterCardWidth}" HorizontalOptions="Center">
                            <Grid>
                                <Image Source="{Binding CoverDisplay}" Aspect="AspectFill" />
                                <!-- 占位海报（本地渲染，零网络）：封面解析不到时显示，保证绝不留白 -->
                                <Border StrokeThickness="0" IsVisible="False" Padding="10"
                                        Background="{DynamicResource PosterPlaceholderBrush}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding CoverDisplay}" Value="{x:Null}">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Title}" FontSize="12.5" FontAttributes="Bold"
                                           TextColor="#D8DDF5" HorizontalTextAlignment="Center"
                                           VerticalOptions="Center" MaxLines="4" LineBreakMode="TailTruncation" />
                                </Border>
                                <Border HorizontalOptions="End" VerticalOptions="Start" Margin="0,7,7,0"
                                        StrokeThickness="0" BackgroundColor="#80000000" StrokeShape="RoundRectangle 8" Padding="6,1"
                                        IsVisible="{Binding HasRemark}">
                                    <Label Text="{Binding Remark}" FontSize="10" TextColor="#FFD76E" MaxLines="1" />
                                </Border>
                            </Grid>
                        </Border>
                        <Label Text="{Binding Title}" FontSize="12" Margin="0,6,0,0"
                               LineBreakMode="TailTruncation" MaxLines="2"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Text="{Binding Meta}" FontSize="10" Margin="0,2,0,0"
                               LineBreakMode="TailTruncation" MaxLines="1"
                               TextColor="{DynamicResource TextHintColor}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="1" x:Name="EmptyLabel"
               Text="暂无收藏，在影片详情页点「收藏」添加"
               FontSize="13" HorizontalTextAlignment="Center" VerticalOptions="Center"
               TextColor="{DynamicResource TextHintColor}" IsVisible="False" />

    </Grid>

</ContentView>
