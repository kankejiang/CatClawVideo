<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawVideo.Maui.Pages.HomePage"
             BackgroundColor="Transparent">

    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,24" Spacing="14">

            <!-- 分类 chips（真数据：当前源分类目录） -->
            <CollectionView x:Name="CategoryChips"
                            SelectionMode="Single"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory, Mode=OneWayToSource}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14,6" Margin="0,0,0,0"
                                BackgroundColor="{DynamicResource ChipInactiveColor}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{DynamicResource ChipInactiveColor}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <Label Text="{Binding Name}" FontSize="11.5" TextColor="{DynamicResource TextSecondaryColor}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 加载状态 -->
            <Label Text="{Binding HomeStatus}" FontSize="12"
                   TextColor="{DynamicResource TextHintColor}" />

            <!-- 海报网格（真数据：当前源影片列表，Windows 6 列 / 安卓横屏 4 列） -->
            <CollectionView x:Name="PosterGrid" SelectionMode="Single" ItemsSource="{Binding Items}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="6" VerticalItemSpacing="18" HorizontalItemSpacing="14" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="0">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{DynamicResource CardBackgroundColor}" HeightRequest="190">
                                <Grid>
                                    <Image Source="{Binding Cover}" Aspect="AspectFill" />
                                    <Label Text="🎬" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{DynamicResource TextHintColor}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Cover}" Value="{x:Null}">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Border HorizontalOptions="End" VerticalOptions="Start" Margin="0,8,8,0"
                                            StrokeThickness="0" BackgroundColor="#80000000" StrokeShape="RoundRectangle 8" Padding="6,1">
                                        <Label Text="{Binding Remarks}" FontSize="10" TextColor="#FFD76E" MaxLines="1" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Label Text="{Binding Title}" FontSize="12.5" Margin="0,7,0,0"
                                   LineBreakMode="TailTruncation" MaxLines="1"
                                   TextColor="{DynamicResource TextPrimaryColor}" />
                            <Label Text="{Binding Year}" FontSize="10.5" Margin="0,2,0,0"
                                   TextColor="{DynamicResource TextHintColor}" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPosterTapped" />
                            </Grid.GestureRecognizers>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 快速播放（开发用播放链路验证入口） -->
            <Border StrokeThickness="1" Margin="0,18,0,0"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="快速播放（开发用）"
                           FontSize="14" FontFamily="OpenSansSemibold"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <Label Text="输入直链地址（m3u8 / mp4）验证播放链路，或播放 HLS 测试流"
                           FontSize="12" TextColor="{DynamicResource TextSecondaryColor}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0"
                               Placeholder="https://example.com/video.m3u8"
                               PlaceholderColor="{DynamicResource TextHintColor}"
                               Text="{Binding UrlInput, Mode=TwoWay}"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               Keyboard="Url" ReturnType="Go"
                               ReturnCommand="{Binding PlayCommand}" />
                        <Button Grid.Column="1" Text="播放"
                                Command="{Binding PlayTestStreamCommand}"
                                FontFamily="OpenSansSemibold" TextColor="White"
                                BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}"
                                CornerRadius="10" Padding="18,6" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
