<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawVideo.Maui.Pages.HomePage"
             BackgroundColor="Transparent">

    <!-- 根用 Grid（不能用 ScrollView 包 CollectionView）：海报墙占 * 行获得有界高度，
         内部滚动 + 虚拟化 + RemainingItemsThresholdReached 才能触发无限滚动。
         注意：安卓横屏可用高度很小（约 320dp），故 chrome 只保留「站点条 / 分类」两行
         （加载状态并入站点条中列），并收紧内边距与行距，把高度尽量让给海报墙。 -->
    <Grid RowDefinitions="Auto,Auto,*" Padding="24,12,24,14" RowSpacing="10">

        <!-- 站点条：当前数据源 + 切换入口（TVBox 同款：分类 chips 首位固定「主页」，
             主页内容 = 豆瓣推荐行流，见下方 HomeRowsScroll） -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,24,0">
            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                <Image Source="ic_library_white.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                <Label Text="{Binding SiteDisplayName}" FontSize="14" FontFamily="OpenSansSemibold"
                       LineBreakMode="TailTruncation" MaxLines="1"
                       TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- 加载/统计状态：并入站点条中列（原为独立一行，横屏下白占约 27dp） -->
            <Label Grid.Column="1" Text="{Binding HomeStatus}" FontSize="11.5"
                   Margin="14,0,14,0" LineBreakMode="TailTruncation" MaxLines="1"
                   TextColor="{DynamicResource TextHintColor}" VerticalOptions="Center" />

            <!-- 右侧动作：直播（从全局顶栏挪来，只在"找内容"时用） + 切换源 -->
            <HorizontalStackLayout Grid.Column="2" Spacing="8" HorizontalOptions="End" VerticalOptions="Center">

                <!-- 直播：TVBox 直播间的入口（全屏推入页，路由 live） -->
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14,6"
                        BackgroundColor="{DynamicResource ChipInactiveColor}">
                    <HorizontalStackLayout Spacing="6">
                        <Ellipse WidthRequest="7" HeightRequest="7" Fill="#e53935" VerticalOptions="Center" />
                        <Label Text="直播" FontSize="11.5"
                               TextColor="{DynamicResource TextSecondaryColor}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLiveTapped" />
                    </Border.GestureRecognizers>
                </Border>


                <!-- 筛选（对位 TVBox GridFilterDialog）：站点没返回 filters 时整块隐藏 -->
                <Border x:Name="FilterShell" IsVisible="False"
                        StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14,6"
                        BackgroundColor="{DynamicResource ChipInactiveColor}">
                    <HorizontalStackLayout Spacing="6">
                        <Label x:Name="FilterLabel" Text="筛选" FontSize="11.5"
                               TextColor="{DynamicResource TextSecondaryColor}"
                               LineBreakMode="TailTruncation" MaxLines="1"
                               VerticalOptions="Center" />
                        <Label Text="▾" FontSize="10"
                               TextColor="{DynamicResource TextSecondaryColor}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- 切换源（遥控器可聚焦，见 HomePage.xaml.cs 的 SwitchSiteShell 焦点环） -->
                <Border x:Name="SwitchSiteShell"
                        StrokeThickness="2" Stroke="Transparent"
                        StrokeShape="RoundRectangle 16" Padding="2" Margin="-2"
                        VerticalOptions="Center">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14,6"
                            BackgroundColor="{DynamicResource ChipInactiveColor}">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="切换源" FontSize="11.5"
                                   TextColor="{DynamicResource TextSecondaryColor}" VerticalOptions="Center" />
                            <Image Source="ic_refresh_white.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSwitchSiteTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- 分类 chips（真数据：当前源分类目录）
             注意：此处原用 CollectionView + SelectionMode=Single，Windows 上选中后 item 容器
             未释放指针捕获，会导致后续所有点击（含顶部导航 tab）失效，故改为 BindableLayout + Tap。 -->
        <ScrollView Grid.Row="1" x:Name="CategoryScroll" Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="CategoryChipHost" Spacing="8" Padding="0,0,24,0"
                                   BindableLayout.ItemsSource="{Binding Categories}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <!-- 外层 = 焦点环壳（不占布局：负 margin 抵消 padding），内层 = 分类 chip（点击/选中态）。
                             两层都在模板里静态声明，禁止运行时重排：旧版由代码后台包壳（把 chip 摘出再塞进新
                             Border）会重挂原生视图，Android 上切站点后 Tap 手势整体失效（点击分类无反应）。 -->
                        <Border StrokeThickness="2" Stroke="Transparent"
                                StrokeShape="RoundRectangle 16" Padding="2" Margin="-2">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14,6"
                                    BackgroundColor="{DynamicResource ChipInactiveColor}">
                                <Label Text="{Binding Name}" FontSize="11.5"
                                       TextColor="{DynamicResource TextSecondaryColor}" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCategoryTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 主页推荐（TVBox 式首页）：多行网格，排列与海报大小和片库网格完全一致
             （同一 PosterCardStyle + PosterLayoutHelper 列数自适应）。
             内容由设置「主页推荐内容」三选一：站点推荐 / 豆瓣热播 / 观看历史。 -->
        <Grid Grid.Row="2" x:Name="HomeRecHost">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <HorizontalStackLayout Grid.Row="0" Spacing="8" VerticalOptions="Center">
                    <BoxView WidthRequest="3" HeightRequest="14" CornerRadius="2"
                             Color="{DynamicResource PrimaryColor}" VerticalOptions="Center" />
                    <Label Text="{Binding HomeRecTitle}" FontSize="14.5" FontFamily="OpenSansSemibold"
                           TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <CollectionView Grid.Row="1" x:Name="HomeGrid" SelectionMode="Single"
                                ItemsSource="{Binding HomeRecItems}"
                                ItemsUpdatingScrollMode="KeepScrollOffset">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="6" VerticalItemSpacing="16" HorizontalItemSpacing="14" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid RowDefinitions="Auto,Auto">
                                <Border Style="{StaticResource PosterCardStyle}">
                                    <Grid>
                                        <Image Source="{Binding CoverDisplay}" Aspect="AspectFill" />
                                        <!-- 占位海报（无封面时显示，绝不留白） -->
                                        <Border StrokeThickness="0" IsVisible="False" Padding="10"
                                                Background="{DynamicResource PosterPlaceholderBrush}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding CoverDisplay}" Value="{x:Null}">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Title}" FontSize="12.5" FontAttributes="Bold"
                                                   TextColor="#D8DDF5" HorizontalTextAlignment="Center"
                                                   VerticalOptions="Center" MaxLines="4" LineBreakMode="TailTruncation" />
                                        </Border>
                                        <Border HorizontalOptions="End" VerticalOptions="Start" Margin="0,7,7,0"
                                                StrokeThickness="0" BackgroundColor="#80000000" StrokeShape="RoundRectangle 8" Padding="6,1"
                                                IsVisible="{Binding HasRemark}">
                                            <Label Text="{Binding Remarks}" FontSize="10" TextColor="#FFD76E" MaxLines="1" />
                                        </Border>
                                        <Border Style="{StaticResource PosterFocusRingStyle}"
                                                IsVisible="{Binding IsFocused}" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Row="1" Spacing="0">
                                    <Label Text="{Binding Title}" FontSize="12" Margin="0,6,0,0"
                                           LineBreakMode="TailTruncation" MaxLines="2"
                                           TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label Text="{Binding Year}" FontSize="10" Margin="0,2,0,0"
                                           LineBreakMode="TailTruncation" MaxLines="1"
                                           TextColor="{DynamicResource TextHintColor}" />
                                </VerticalStackLayout>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPosterTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- 海报网格（真数据：当前源影片列表；列数与卡片高度由代码按可用空间自适应，
             保证卡片宽高比贴近海报 2:3 且一整行能完整显示） -->
        <CollectionView Grid.Row="2" x:Name="PosterGrid" SelectionMode="Single" ItemsSource="{Binding Items}"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                        RemainingItemsThreshold="8"
                        ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="6" VerticalItemSpacing="16" HorizontalItemSpacing="14" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid RowDefinitions="Auto,Auto">
                        <!-- 尺寸 / 圆角 / 遥控器焦点环见 Styles.xaml 的 PosterCardStyle（四处海报墙共用） -->
                        <Border Style="{StaticResource PosterCardStyle}">
                            <Grid>
                                <Image Source="{Binding CoverDisplay}" Aspect="AspectFill" />
                                <!-- 占位海报（本地渲染，零网络）：封面解析不到时显示，保证绝不留白 -->
                                <Border StrokeThickness="0" IsVisible="False" Padding="10"
                                        Background="{DynamicResource PosterPlaceholderBrush}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding CoverDisplay}" Value="{x:Null}">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Title}" FontSize="12.5" FontAttributes="Bold"
                                           TextColor="#D8DDF5" HorizontalTextAlignment="Center"
                                           VerticalOptions="Center" MaxLines="4" LineBreakMode="TailTruncation" />
                                </Border>
                                <Border HorizontalOptions="End" VerticalOptions="Start" Margin="0,7,7,0"
                                        StrokeThickness="0" BackgroundColor="#80000000" StrokeShape="RoundRectangle 8" Padding="6,1"
                                        IsVisible="{Binding HasRemark}">
                                    <Label Text="{Binding Remarks}" FontSize="10" TextColor="#FFD76E" MaxLines="1" />
                                </Border>
                            </Grid>
                        </Border>
                        <!-- 焦点环与卡片**平级**（只覆盖海报那一行）。放进卡片内部一定会被卡片的
                             StrokeShape 裁掉一侧 —— 改了几轮才定位到的死结；平级后只受格子边界约束。 -->
                        <Border Grid.Row="0" Style="{StaticResource PosterFocusRingStyle}"
                                IsVisible="{Binding IsFocused}" />
                        <VerticalStackLayout Grid.Row="1" Spacing="0">
                            <Label Text="{Binding Title}" FontSize="12" Margin="0,6,0,0"
                                   LineBreakMode="TailTruncation" MaxLines="2"
                                   TextColor="{DynamicResource TextPrimaryColor}" />
                            <Label Text="{Binding Year}" FontSize="10" Margin="0,2,0,0"
                                   LineBreakMode="TailTruncation" MaxLines="1"
                                   TextColor="{DynamicResource TextHintColor}" />
                        </VerticalStackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPosterTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 冷启动遮罩：引擎冷启动实测 41~46 秒（解包内核与根镜像 + Android 13 运行时启动）
             + 订阅恢复期间，海报墙全空、只有一行小字，体感如同卡死。这里用全屏遮罩分阶段显示
             真实进度（恢复订阅 → 引擎冷启动 → 首页数据），首页数据就绪后淡出进主界面。
             覆盖三行（RowSpan=3）+ 不透明背景，避免底下空海报墙透出。
             2026-10-03 重设计：品牌 → 进度 → 启动自检卡片；进度条移到底部通栏。 -->
        <!-- ★ IsVisible 不再硬编码 True：Android 端没有 QEMU/ART 引擎冷启动，
     显示这个遮罩全是假的进度与文案（用户反馈：安卓端也弹启动画面）。
     可见性改由 HomePage.xaml.cs 按平台设置（Windows 才显示，见 StartColdStartOverlay）。 -->
        <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="ColdStartOverlay" IsVisible="False"
              BackgroundColor="{DynamicResource WindowBackgroundColor}">
            <VerticalStackLayout VerticalOptions="Center" Spacing="20" Padding="0,0,0,36"
                                 HorizontalOptions="Center">

                <VerticalStackLayout Spacing="8">
                    <Image Source="ic_brand.png" WidthRequest="72" HeightRequest="72"
                           HorizontalOptions="Center" />
                    <Label Text="猫爪影视" FontSize="27" FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                </VerticalStackLayout>

                <!-- 进度区：转圈与百分比同行（原来「转圈 + 数字 + 进度条」三个信号分三行，
                     视觉噪声大），阶段文案在下面；真实进度条贴窗口底部通栏（见本 Grid 末尾）。 -->
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <ActivityIndicator IsRunning="True" WidthRequest="18" HeightRequest="18"
                                           VerticalOptions="Center"
                                           Color="{DynamicResource PrimaryColor}" />
                        <Label x:Name="ColdStartPct" Text="0%" FontSize="25" FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                    </HorizontalStackLayout>
                    <Label x:Name="ColdStartStatus" FontSize="13" MaxLines="2" WidthRequest="480"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource TextSecondaryColor}" />
                </VerticalStackLayout>

                <!-- 启动自检卡片（Windows 一次性探测，逻辑见 Services/StartupEnvCheck）：
                     单行「圆点 + 名称 + 值」，异常项追加一行处置建议；全部通过时只显示绿色药丸。
                     目的是让用户第一眼看到根因，而不是去翻 home-debug.log。 -->
                <Border x:Name="EnvCheckPanel" IsVisible="False" WidthRequest="520"
                        BackgroundColor="{DynamicResource InputBackgroundColor}"
                        Stroke="{DynamicResource InputBorderColor}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="18,13">
                    <VerticalStackLayout Spacing="9">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="启动自检" FontSize="13" FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}" />
                            <Border x:Name="EnvCheckBadge" Grid.Column="1" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9" Padding="9,2"
                                    VerticalOptions="Center">
                                <Label x:Name="EnvCheckSummary" FontSize="11.5" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />
                        <VerticalStackLayout x:Name="EnvCheckList" Spacing="7" />

                        <!-- 一键处置：仅在存在可执行的异常项时出现
                             （一键启用虚拟化 / 自动取件 / 打开下载页 / 打开数据目录）。 -->
                        <HorizontalStackLayout x:Name="EnvCheckActions" IsVisible="False"
                                               Spacing="8" HorizontalOptions="End" Margin="0,2,0,0" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="冷启动仅发生在每次开机后的首次访问，之后秒开" FontSize="11" Opacity="0.6"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource TextHintColor}" />
            </VerticalStackLayout>

            <!-- 底部通栏进度条：贴窗口底边、宽度 = 窗口宽度，高度 4px 走细线观感；与遮罩一起淡出。
                 ⚠ 负边距用来抵消根 Grid 的 Padding="24,12,24,14"（遮罩是它的子元素、会被内缩），
                 这样进度条才真的齐窗口左右边与底边；若改动根 Grid 的 Padding，这里要同步改。 -->
            <ProgressBar x:Name="ColdStartProgress" Progress="0.01"
                         HeightRequest="4" Margin="-24,0,-24,-14"
                         HorizontalOptions="Fill" VerticalOptions="End"
                         ProgressColor="{DynamicResource PrimaryColor}" />
        </Grid>

    </Grid>

</ContentView>
