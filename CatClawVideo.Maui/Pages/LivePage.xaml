<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CatClawVideo.Maui.Controls"
             x:Class="CatClawVideo.Maui.Pages.LivePage"
             BackgroundColor="#000000"
             NavigationPage.HasNavigationBar="False">

    <!-- 隐藏 Shell 系统返回键（页面自带自定义返回，同 WatchPage） -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <Style x:Key="LiveChip" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#26FFFFFF" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style x:Key="LiveChipText" TargetType="Label">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextColor" Value="#F5F6FF" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <!-- 播放器（直播流：m3u8 / ts / flv 等由平台播放器直起） -->
        <controls:VideoPlayerView x:Name="Player" Aspect="AspectFit" ShouldKeepScreenOn="True" />

        <!-- 手势层：轻点切换控制条显隐（直播页没有进度条，轻点=呼出信息） -->
        <Grid x:Name="TapLayer" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSurfaceTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- 空态：未配置 / 加载失败 -->
        <VerticalStackLayout x:Name="EmptyState" IsVisible="False" Spacing="14"
                             HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="还没有可用的直播源" FontSize="16" FontFamily="OpenSansSemibold"
                   TextColor="{DynamicResource TextPrimaryColor}" HorizontalOptions="Center" />
            <Label x:Name="EmptyDetail" FontSize="12" TextColor="{DynamicResource TextSecondaryColor}"
                   HorizontalTextAlignment="Center" MaximumWidthRequest="420" />
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border BackgroundColor="{DynamicResource PrimaryButtonBackgroundColor}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 10" Padding="18,9">
                    <Label Text="配置直播源" FontSize="13" TextColor="White" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOpenConfigTapped" />
                    </Border.GestureRecognizers>
                </Border>
                <Border Style="{StaticResource LiveChip}" Padding="18,9">
                    <Label Text="返回" Style="{StaticResource LiveChipText}" FontSize="13" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- 遮罩：抽屉 / 设置面板打开时点击关闭 -->
        <Grid x:Name="Scrim" IsVisible="False" BackgroundColor="#66000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrimTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- 顶部：频道信息 + 时钟 + 右上按钮组 -->
        <Grid x:Name="TopChrome" IsVisible="False" VerticalOptions="Start"
              ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="16,12">
            <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                <Label x:Name="LblChannelInfo" FontSize="13.5" FontFamily="OpenSansSemibold" TextColor="#FFFFFF" />
                <Label x:Name="LblClock" FontSize="12" TextColor="#B3FFFFFF" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="8" x:Name="ChromeActions">
                <Border Style="{StaticResource LiveChip}" x:Name="BtnChannelList">
                    <Label Text="频道" Style="{StaticResource LiveChipText}" />
                </Border>
                <Border Style="{StaticResource LiveChip}" x:Name="BtnSettingsPanel">
                    <Label Text="设置" Style="{StaticResource LiveChipText}" />
                </Border>
                <Border Style="{StaticResource LiveChip}" x:Name="BtnClose">
                    <Label Text="✕" Style="{StaticResource LiveChipText}" />
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- 底部 EPG 信息条（当前 / 下一节目） -->
        <Border x:Name="BottomBar" IsVisible="False" VerticalOptions="End" Margin="16,0,16,16" Padding="18,12"
                BackgroundColor="#CC0B0D20" StrokeThickness="0" StrokeShape="RoundRectangle 14">
            <VerticalStackLayout Spacing="3">
                <Label x:Name="LblBottomTitle" FontSize="13.5" FontFamily="OpenSansSemibold" TextColor="#FFFFFF" />
                <Label x:Name="LblEpgNow" FontSize="12" TextColor="#D9FFFFFF" />
                <Label x:Name="LblEpgNext" FontSize="11.5" TextColor="#99FFFFFF" />
            </VerticalStackLayout>
        </Border>

        <!-- 换台悬浮按钮 -->
        <Border x:Name="BtnPrev" IsVisible="False" VerticalOptions="Center" HorizontalOptions="Start" Margin="12,0"
                BackgroundColor="#40000000" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                WidthRequest="44" HeightRequest="44">
            <Label Text="‹" FontSize="26" TextColor="#E6FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPrevTapped" />
            </Border.GestureRecognizers>
        </Border>
        <Border x:Name="BtnNext" IsVisible="False" VerticalOptions="Center" HorizontalOptions="End" Margin="12,0"
                BackgroundColor="#40000000" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                WidthRequest="44" HeightRequest="44">
            <Label Text="›" FontSize="26" TextColor="#E6FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNextTapped" />
            </Border.GestureRecognizers>
        </Border>

        <!-- 频道抽屉：左列分组 / 右列频道（对应 TVBox 左抽屉三列的前两列） -->
        <Grid x:Name="Drawer" IsVisible="False" WidthRequest="380" HorizontalOptions="Start"
              BackgroundColor="#F20B0D20" ColumnDefinitions="152,*">
            <ScrollView Grid.Column="0" BackgroundColor="#0DFFFFFF">
                <VerticalStackLayout x:Name="GroupList" Padding="10,14" Spacing="6" />
            </ScrollView>
            <ScrollView Grid.Column="1">
                <VerticalStackLayout x:Name="ChannelList" Padding="10,14" Spacing="6" />
            </ScrollView>
        </Grid>

        <!-- 设置面板：线路 / 超时换源 / 多源切换 / 操作 -->
        <Border x:Name="SettingsPanel" IsVisible="False" WidthRequest="330" HorizontalOptions="End"
                BackgroundColor="#F20B0D20" StrokeThickness="0" Padding="0">
            <ScrollView>
                <VerticalStackLayout x:Name="SettingsList" Padding="18,16,18,20" Spacing="12">
                    <Label Text="线路选择" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#FFFFFF" />
                    <FlexLayout x:Name="LineList" Wrap="Wrap" Direction="Row" />
                    <Label Text="超时换源" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#FFFFFF" Margin="0,6,0,0" />
                    <FlexLayout x:Name="TimeoutList" Wrap="Wrap" Direction="Row" />
                    <Label Text="直播源（多源切换）" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#FFFFFF" Margin="0,6,0,0" />
                    <FlexLayout x:Name="SourceList" Wrap="Wrap" Direction="Row" />
                    <Label Text="遥控与显示" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#FFFFFF" Margin="0,6,0,0" />
                    <FlexLayout x:Name="PrefList" Wrap="Wrap" Direction="Row" />
                    <BoxView HeightRequest="1" Color="#1AFFFFFF" Margin="0,6" />
                    <Border Style="{StaticResource LiveChip}" Padding="14,9">
                        <Label Text="重新加载直播源" Style="{StaticResource LiveChipText}" FontSize="13" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReloadSourceTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Style="{StaticResource LiveChip}" Padding="14,9">
                        <Label Text="打开直播源配置" Style="{StaticResource LiveChipText}" FontSize="13" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenConfigTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Label x:Name="LblSourceTag" FontSize="11" TextColor="#80FFFFFF" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- 轻提示 -->
        <Border x:Name="ToastHost" IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center"
                BackgroundColor="#CC000000" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="18,10">
            <Label x:Name="LblToast" FontSize="13" TextColor="#F5F6FF" />
        </Border>
    </Grid>
</ContentPage>
