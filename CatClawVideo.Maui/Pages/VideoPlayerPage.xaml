<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CatClawVideo.Maui.Controls"
             x:Class="CatClawVideo.Maui.Pages.VideoPlayerPage"
             BackgroundColor="Black"
             NavigationPage.HasNavigationBar="False">

    <!-- 隐藏 Shell 系统返回键（控制层自带返回按钮，避免左上角双返回按钮，同 WatchPage） -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid x:Name="PlayerRoot">

        <Grid.GestureRecognizers>
            <!-- 点击画面切换控件层：挂在常驻根 Grid 上（控件层隐藏后其自身手势不生效） -->
            <TapGestureRecognizer Tapped="OnSurfaceTapped" />
        </Grid.GestureRecognizers>

        <!-- 播放器：铺满，自定义控制层 -->
        <controls:VideoPlayerView x:Name="Player"
                                  Aspect="AspectFit"
                                  ShouldAutoPlay="True"
                                  ShouldKeepScreenOn="True"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill" />

        <!-- 缓冲指示：圆环进度 + 中央百分比（不遮整屏，只覆盖中央区域） -->
        <Grid x:Name="BufferingIndicator"
              IsVisible="{Binding IsBuffering}"
              HorizontalOptions="Center"
              VerticalOptions="Center">
            <BoxView Color="#59000000" InputTransparent="True"
                     WidthRequest="110" HeightRequest="110"
                     CornerRadius="55" />
            <controls:BufferProgressView x:Name="BufferRing" Diameter="76" />
        </Grid>

        <!-- 错误面板 -->
        <VerticalStackLayout x:Name="ErrorPanel"
                             IsVisible="{Binding IsFailed}"
                             Spacing="14"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Padding="32">
            <Label Text="播放失败"
                   FontSize="17"
                   FontFamily="OpenSansSemibold"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding ErrorMessage}"
                   FontSize="12"
                   TextColor="#CCFFFFFF"
                   LineBreakMode="WordWrap"
                   MaxLines="4"
                   HorizontalTextAlignment="Center" />
            <Button x:Name="RetryButton"
                    Text="重试"
                    CornerRadius="18"
                    Padding="20,8"
                    FontSize="13"
                    TextColor="White"
                    BackgroundColor="#33FFFFFF"
                    Clicked="OnRetryClicked" />
        </VerticalStackLayout>

        <!-- ═══ 自定义控制层（方案 B · 悬浮双行面板） ═══ -->
        <Grid x:Name="ControlsOverlay"
              RowDefinitions="Auto,*"
              IsVisible="{Binding ControlsVisible}"
              InputTransparent="False">

            <!-- 顶栏：返回 / 标题 / 横竖屏切换 -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  Padding="12,10,12,10"
                  BackgroundColor="#66000000">
                <ImageButton Grid.Column="0"
                             x:Name="BackButton"
                             Source="ic_back.png"
                             WidthRequest="40" HeightRequest="40"
                             CornerRadius="20"
                             BackgroundColor="Transparent"
                             Clicked="OnBackClicked" />
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       FontSize="15"
                       FontFamily="OpenSansSemibold"
                       TextColor="White"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       Margin="10,0"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />
                <ImageButton Grid.Column="2"
                             x:Name="RotateButton"
                             Source="ic_rotate.png"
                             WidthRequest="40" HeightRequest="40"
                             CornerRadius="20"
                             BackgroundColor="Transparent"
                             Command="{Binding ToggleLandscapeCommand}"
                             IsVisible="False" />
            </Grid>

            <!-- 中央播放/暂停（仅在暂停时出现，与底部常驻播放键互斥，避免重复） -->
            <ImageButton Grid.Row="1"
                         x:Name="CenterPlayButton"
                         Source="ic_play.png"
                         WidthRequest="64" HeightRequest="64"
                         CornerRadius="32"
                         BackgroundColor="#33000000"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Clicked="OnPlayPauseClicked" />

            <!-- 底部悬浮控件条（方案 B） -->
            <controls:PlaybackControlBar Grid.Row="1" x:Name="ControlBar" />

        </Grid>

    </Grid>

</ContentPage>
