<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatClawVideo.Maui.Pages.AboutPage"
             Title="关于"
             BackgroundColor="{DynamicResource WindowBackgroundColor}"
             NavigationPage.HasNavigationBar="False">

    <!-- 隐藏 Shell 系统返回键（页面自带自定义返回，避免左上角双返回按钮，同 SourceConfigPage） -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <!-- 无独立顶栏：返回按钮改为浮在内容区之上。
         原先「顶部安全区 padding + 独立标题行」在页首堆出一条与渐变内容不连续的不透明深色带
         （2026-09-18 用户实测报告），去掉标题行并由本页自行隐藏状态栏后即消失。 -->
    <Grid BackgroundColor="{DynamicResource WindowBackgroundColor}">

        <!-- ═══ 主体：左右分栏（横屏，手机同样使用本布局） ═══
             左 42%：品牌区（无卡片框，融入背景，图标辉光）
             右 58%：简介 + 行式操作列表 + 检查更新 + 版权
             背景：左上紫色径向光晕，像影院幕布灯 -->
        <Grid ColumnDefinitions="42*,58*">
            <Grid.Background>
                <RadialGradientBrush Center="0.16,0.0" Radius="0.72">
                    <GradientStop Color="#4D9B7ED8" Offset="0" />
                    <GradientStop Color="#0012102B" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <!-- ─── 左栏：品牌区 ─── -->
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center"
                                 Padding="44,20" HorizontalOptions="Center">
                <Border WidthRequest="96" HeightRequest="96"
                        StrokeShape="RoundRectangle 26"
                        Stroke="#14FFFFFF" StrokeThickness="4"
                        HorizontalOptions="Center" Padding="0">
                    <Border.Shadow>
                        <Shadow Brush="#F55E9C" Opacity="0.40" Radius="44" Offset="0,12" />
                    </Border.Shadow>
                    <Image Source="ic_brand.png" Aspect="AspectFit"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="猫爪影视" FontSize="30" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       HorizontalOptions="Center" Margin="0,18,0,0" />
                <Border StrokeThickness="1" StrokeShape="RoundRectangle 99"
                        BackgroundColor="#1F55D6FF" Stroke="#3855D6FF"
                        HorizontalOptions="Center" Padding="13,3" Margin="0,10,0,0">
                    <Label Text="{Binding Version}" FontSize="12.5" FontAttributes="Bold"
                           TextColor="#55D6FF" HorizontalOptions="Center" />
                </Border>
                <Label Text="一只会找片的猫爪喵——本地、私域、订阅源，都给你安排好啦"
                       FontSize="13.5"
                       HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       HorizontalOptions="Center" Margin="0,12,0,0" />
            </VerticalStackLayout>

            <!-- ─── 右栏：简介 + 操作 ─── -->
            <ScrollView Grid.Column="1">
                <VerticalStackLayout VerticalOptions="Center"
                                     Padding="8,20,44,20" Spacing="16">

                    <Label Text="跨平台影视播放器（Android / Windows），支持猫爪源本地文件与 TVBox / 影视仓订阅，提供站点订阅、分类浏览、跨源搜索与多线路播放。"
                           FontSize="12.5"
                           LineBreakMode="WordWrap"
                           TextColor="{DynamicResource TextHintColor}"
                           Margin="4,0,0,0" />

                    <!-- 行式操作列表 -->
                    <Border StrokeThickness="1" StrokeShape="RoundRectangle 16"
                            BackgroundColor="#07FFFFFF" Stroke="{DynamicResource DividerColor}"
                            Padding="0">
                        <VerticalStackLayout>

                            <!-- 免责声明 -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="18,13">
                                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        BackgroundColor="#24FFC107" VerticalOptions="Center">
                                    <Label Text="⚠️" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="免责声明" FontSize="14.5" FontFamily="OpenSansSemibold"
                                           TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label Text="本项目仅为播放器壳，不内置任何片源" FontSize="12"
                                           TextColor="{DynamicResource TextHintColor}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="16" VerticalOptions="Center"
                                       TextColor="{DynamicResource TextHintColor}" Opacity="0.55" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewDisclaimerCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />

                            <!-- 开源协议 -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="18,13">
                                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        BackgroundColor="#2255D6FF" VerticalOptions="Center">
                                    <Label Text="📄" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="开源协议" FontSize="14.5" FontFamily="OpenSansSemibold"
                                           TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label Text="MIT License" FontSize="12"
                                           TextColor="{DynamicResource TextHintColor}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="16" VerticalOptions="Center"
                                       TextColor="{DynamicResource TextHintColor}" Opacity="0.55" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewLicenseCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />

                            <!-- 猫爪音乐 -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="18,13">
                                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        BackgroundColor="#24F55E9C" VerticalOptions="Center">
                                    <Label Text="🎵" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="猫爪音乐" FontSize="14.5" FontFamily="OpenSansSemibold"
                                           TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label Text="同作者的跨平台音乐播放器" FontSize="12"
                                           TextColor="{DynamicResource TextHintColor}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="16" VerticalOptions="Center"
                                       TextColor="{DynamicResource TextHintColor}" Opacity="0.55" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenMusicCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />

                            <!-- QQ 交流群 -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="18,13">
                                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        BackgroundColor="#241296DB" VerticalOptions="Center">
                                    <Label Text="💬" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="QQ 交流群" FontSize="14.5" FontFamily="OpenSansSemibold"
                                           TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label Text="855383639 · 反馈问题 / 交流片源" FontSize="12"
                                           TextColor="{DynamicResource TextHintColor}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="16" VerticalOptions="Center"
                                       TextColor="{DynamicResource TextHintColor}" Opacity="0.55" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding JoinGroupCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />

                            <!-- GitHub -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="18,13">
                                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        BackgroundColor="#24FFFFFF" VerticalOptions="Center">
                                    <Label Text="⭐" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="GitHub" FontSize="14.5" FontFamily="OpenSansSemibold"
                                           TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label Text="kankejiang/CatClawVideo" FontSize="12"
                                           TextColor="{DynamicResource TextHintColor}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="16" VerticalOptions="Center"
                                       TextColor="{DynamicResource TextHintColor}" Opacity="0.55" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenGitHubCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                    <!-- 检查更新：渐变主按钮 -->
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 15"
                            HeightRequest="48" HorizontalOptions="Fill">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#9B7ED8" Offset="0" />
                                <GradientStop Color="#6E4FD0" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#6E4FD0" Opacity="0.40" Radius="24" Offset="0,8" />
                        </Border.Shadow>
                        <Label Text="{Binding CheckUpdateButtonText}" FontSize="14.5" FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CheckUpdateCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Label Text="{Binding Copyright}" FontSize="11.5"
                           TextColor="{DynamicResource TextHintColor}"
                           HorizontalOptions="Center" />

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- 悬浮返回 + 标题：位于内容区之上（同层后声明者绘制在上层），
             宽度只占自身内容、靠左上角，不遮挡右栏列表的点击。 -->
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12"
              Padding="24,16,0,0" VerticalOptions="Start" HorizontalOptions="Start">
            <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="{DynamicResource ChipInactiveColor}"
                    StrokeShape="RoundRectangle 12" WidthRequest="38" HeightRequest="38">
                <Image Source="ic_back.png" WidthRequest="18" HeightRequest="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1" Text="关于" FontSize="15" FontFamily="OpenSansSemibold"
                   TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="Center" />
        </Grid>

        <!-- ═══ 检查更新弹窗（自定义卡片，替代系统 DisplayAlert） ═══ -->
        <Grid x:Name="UpdateOverlay" IsVisible="False" BackgroundColor="#AA0A0A18">
            <Border x:Name="UpdateCard" WidthRequest="470" HorizontalOptions="Center" VerticalOptions="Center"
                    StrokeThickness="1" StrokeShape="RoundRectangle 20" Stroke="#22FFFFFF"
                    BackgroundColor="#FF1E1E30" Padding="24,22">
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.55" Radius="32" Offset="0,10" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label x:Name="UpdateTitleLabel" Grid.Column="0" Text="发现新版本" FontSize="17"
                               FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimaryColor}"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1" BackgroundColor="#1F55D6FF" Stroke="#3855D6FF"
                                StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,3"
                                VerticalOptions="Center">
                            <Label x:Name="UpdateVersionLabel" Text="v0.0.0" FontSize="12" FontAttributes="Bold"
                                   TextColor="#55D6FF" />
                        </Border>
                    </Grid>

                    <Label x:Name="UpdateSubtitleLabel" FontSize="12" LineBreakMode="WordWrap"
                           TextColor="{DynamicResource TextHintColor}" />

                    <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />

                    <ScrollView x:Name="UpdateNotesScroll">
                        <VerticalStackLayout x:Name="UpdateNotesLayout" Spacing="6" />
                    </ScrollView>

                    <Grid x:Name="UpdateButtonsGrid" ColumnDefinitions="*,140" ColumnSpacing="10">
                        <Border x:Name="UpdateSecondaryButton" Grid.Column="0" StrokeThickness="1"
                                StrokeShape="RoundRectangle 12" Stroke="#33FFFFFF" BackgroundColor="#14FFFFFF"
                                HeightRequest="40">
                            <Label Text="以后再说" FontSize="13.5" TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnUpdateSecondaryTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border x:Name="UpdatePrimaryButton" Grid.Column="1" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12" HeightRequest="40">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#9B7ED8" Offset="0" />
                                    <GradientStop Color="#6E4FD0" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Label x:Name="UpdatePrimaryButtonText" Text="立即下载" FontSize="13.5" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnUpdatePrimaryTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
