<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.26100.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>CatClawVideo.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>15.0</LangVersion>

		<ApplicationTitle>猫爪影视</ApplicationTitle>
		<ApplicationId>com.catclaw.video</ApplicationId>
		<ApplicationDisplayVersion>0.1.2</ApplicationDisplayVersion>
		<ApplicationVersion>3</ApplicationVersion>

		<!-- Android 打包：禁用快速部署，避免 FastDev 状态冲突（同 CatClawMusic 实测结论） -->
		<AndroidUseFastDeployment>false</AndroidUseFastDeployment>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<AndroidPackageFormats>apk</AndroidPackageFormats>
		<HotReloadEnabled>false</HotReloadEnabled>

		<!-- Windows-specific settings -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<!-- 手写 App.generated.cs 绕 .NET 11 + WindowsAppSDK 1.7 的 XamlCompiler 退出码问题（同 CatClawMusic）。
		     宏必须仅 Release 定义：Debug 下 XamlCompiler 正常生成 App.g.i.cs（含 Main），
		     手写文件由下方 Compile Remove 排除，两个入口点并存会报 CS5001。 -->
		<DefineConstants Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<!-- XAML 编译器包装：XamlCompiler.exe 在 .NET 11 上编译成功但退出码为 1，用包装脚本绕过 -->
		<XamlCompilerExePath Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(MSBuildProjectDirectory)\XamlCompilerWrapper.bat</XamlCompilerExePath>
		<!-- MakePri 包装：MakePri.exe x64 版崩溃，包装脚本改用 x86 版并按输出文件判断成功 -->
		<MakePriExeFullPath Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(MSBuildProjectDirectory)\MakePriWrapper.bat</MakePriExeFullPath>

		<!-- Platform min versions -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">31.0</SupportedOSPlatformVersion>
		<TargetAndroidApi Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36</TargetAndroidApi>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64;android-x64</RuntimeIdentifiers>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<!-- MAUI 11 Windows 默认 CV2 处理器在集合隐藏状态下变更时抛 COMException 闪退（dotnet/maui#36632），
		     退回旧 ListView 处理器（同 CatClawMusic），等上游修复后再开。 -->
		<UseWindowsCollectionView2Handler Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</UseWindowsCollectionView2Handler>

		<!-- Windows 窗口/任务栏/桌面快捷方式图标：resizetizer 从 MauiIcon 生成的 .ico 只含
		     单帧 64×64，大图标视图（96/256）会发虚 → 显式指定多分辨率版本
		     （16/24/32/48/64/128/256，由 Pillow 从同一源图生成） -->
		<ApplicationIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">Resources\AppIcon\appicon.ico</ApplicationIcon>

		<!-- Android release：关闭 AOT/裁剪（.NET 11 Android CoreCLR R2R 报 XALNS7015；裁剪影响后续插件加载） -->
		<RunAOTCompilation Condition="'$(Configuration)' == 'Release'">false</RunAOTCompilation>
		<PublishReadyToRun Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</PublishReadyToRun>
		<PublishTrimmed Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</PublishTrimmed>
		<TrimMode Condition="'$(Configuration)' == 'Release'">partial</TrimMode>

		<!-- Windows Release：不输出 .pdb/.xml 调试符号 -->
		<DebugType Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</DebugType>
		<DebugSymbols Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</DebugSymbols>
		<GenerateDocumentationFile Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</GenerateDocumentationFile>
	</PropertyGroup>

	<!-- Debug 版本使用独立 ApplicationId，支持与 Release 共存 -->
	<PropertyGroup>
		<ApplicationId Condition="'$(Configuration)' == 'Debug'">com.catclaw.video.debug</ApplicationId>
		<ApplicationTitle Condition="'$(Configuration)' == 'Debug'">猫爪影视(Debug)</ApplicationTitle>
	</PropertyGroup>

	<!-- Shared project references -->
	<ItemGroup>
		<ProjectReference Include="..\CatClawVideo.Core\CatClawVideo.Core.csproj" />
		<ProjectReference Include="..\CatClawVideo.Data\CatClawVideo.Data.csproj" />
		<!-- 猫爪家族共享库（与 CatClawMusic 共用）：DownloadStatusConverter 等 MAUI 层共享代码 -->
		<ProjectReference Include="..\..\CatClaw.Shared\src\CatClaw.Shared.Maui\CatClaw.Shared.Maui.csproj" />
	</ItemGroup>

	<!-- MAUI resources -->
	<ItemGroup>
		<!-- 应用图标：Resources/AppIcon/appicon.png（1024² 满幅出血），resizetizer 据此
		     生成 Windows .ico 与 Android mipmap 各密度。
		     应用内展示品牌标用 Resources/Images/ic_brand.png（同图 192²）——resizetizer
		     要求输出名唯一，同一文件不能既作 MauiIcon 又作 MauiImage。
		     注意：SVG 只能出现在本文件里，代码中一律按转换后的 .png 名引用（MAUI 规范）。 -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" />
		<MauiSplashScreen Include="Resources\Images\splash_transparent.svg" Color="#0B0D20" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- NuGet packages -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-rc.1.26425.128" />
		<!-- Android 16（16KB 内存页）：SQLitePCLRaw 锁定 16KB 对齐版本（同 CatClawMusic） -->
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
	</ItemGroup>

	<!-- Android-specific: Media3 ExoPlayer（视频播放器内核，版本同 CatClawMusic 已验证组合） -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.10.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Hls" Version="1.10.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Media3.Datasource" Version="1.10.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Media3.UI" Version="1.10.1.1" />
	</ItemGroup>

	<!-- Windows-specific: FFmpegInteropX（FFmpeg 解码注入 WinUI MediaPlayer）。
	     根因：磁力源的 MKV 音轨是 E-AC3（实测 dyg7 源 A_EAC3），WinUI MediaPlayer 走的
	     Media Foundation 默认没有 E-AC3/DTS 解码器（需 Dolby 扩展）——视频正常、全程无声。
	     FFmpeg 解码音频（视频仍 D3D11 硬解），失败时回落原生 MF。 -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<PackageReference Include="FFmpegInteropX" Version="2.1.0.81200" />
	</ItemGroup>

	<!-- FFmpegInteropX 包把 FFmpegInteropX.winmd 作为 Reference 传入（供 C++ 消费），
	     会触发 cswinrt 现场生成投影 → 需要本机安装的 Windows SDK（注册表），构建机没有。
	     该包已自带预生成的 .NET 投影（FFmpegInteropX.DotNet.dll，与 TFM 26100 投影匹配），
	     在 RAR 解析前移除 winmd 引用即可：类型来自预生成 dll，native dll 照常复制。 -->
	<Target Name="RemoveFFmpegInteropXWinmdReference" BeforeTargets="ResolveAssemblyReferences" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ItemGroup>
			<Reference Remove="%(Reference.Identity)" Condition="'%(Reference.Identity)' != '' And '%(Reference.Filename)' == 'FFmpegInteropX' And '%(Reference.Extension)' == '.winmd'" />
		</ItemGroup>
	</Target>

	<PropertyGroup>
		<!-- TFM ≥ 26100 时 .NET SDK 会启用 cswinrt 现场生成投影（CsWinRTEnabled=true），
		     其 Windows 元数据默认按版本号去注册表找本机安装的 Windows SDK —— 构建机没装，
		     报 "Could not find the Windows SDK in the registry"。本应用无需现场生成：
		     Windows.* 类型走预编译的 Microsoft.Windows.SDK.NET.dll，WinAppSDK 类型走
		     预编译的 Microsoft.WindowsAppSDK.dll —— 与 19041 TFM 下的实际行为一致。 -->
		<CsWinRTEnabled Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</CsWinRTEnabled>
	</PropertyGroup>

	<!-- Android Java 源文件：宿主侧 spider 基类 com.github.catvod.crawler.Spider。
	     spider jar 里的爬虫类全部继承该基类（Guard 加固包亦然：BaseSpiderGuard extends Spider），
	     而 jar 自身不打包它，必须由宿主 App 提供；否则 DexClassLoader 解析父类失败，
	     抛 NoClassDefFoundError，表现为「jar 中找不到爬虫类」。
	     ⚠️ .NET for Android 不会自动 glob Platforms/Android 下的 .java，必须显式声明 AndroidJavaSource。 -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidJavaSource Include="Platforms\Android\**\*.java" />
	</ItemGroup>

	<!-- Android Java 库：OkHttp 运行时（spider jar 的真实实现直接依赖 okhttp3，宿主必须提供）。
	     Guard 加固包的外层 classes.dex 只有加固壳，真实实现由 assets/*.guard + native .so 在运行时解密，
	     解密出的代码直接引用 okhttp3（ConnectionPool / Request$Builder / MultipartBody$Builder 等）。
	     TVBox 之所以能用，是因为它自带 OkHttp；宿主不提供就会在调用爬虫方法时抛
	     NoClassDefFoundError: Failed resolution of: Lokhttp3/...
	     版本严格对齐 TVBox 参考实现（app/build.gradle）：okhttp 3.12.11 + okio 2.8.0。
	     okio 2.8.0 为 Kotlin 编译，但其依赖的 kotlin-stdlib 已由本项目的 AndroidX/Media3 NuGet 间接引入
	     （已存在于 lp/*/jl/libs 中），故**不要**再自行打包 kotlin-stdlib —— 会触发 D8 的
	     「Type kotlin.XxxKt is defined multiple times」重复定义错误（JAVA0000）。
	     ⚠️ 用 AndroidJavaLibrary（仅嵌入 dex，不生成 C# 绑定），避免对 Kotlin 元数据做绑定而产生告警/失败。 -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidJavaLibrary Include="Jars\okhttp-3.12.11.jar" />
		<AndroidJavaLibrary Include="Jars\okio-2.8.0.jar" />
		<!-- 迅雷下载引擎 SDK（磁力优先使用；仅嵌入 dex，不生成 C# 绑定）。
		     自包含：thunder.jar 里零引用 TVBox 宿主类，只需宿主提供 Context。 -->
		<AndroidJavaLibrary Include="Jars\thunder.jar" />
	</ItemGroup>

	<!-- Android 原生库：荐片（csp_Jianpian / 壳类 JPJGuard）所需的 P2P 引擎。
	     ⚠️ 荐片爬虫自己不下载：它的 playerContent 会逐个探测 127.0.0.1:9978…9999 找宿主的本地
	     P2P HTTP 服务，探不到就拼出空端口地址 → 播放器报 Source error /
	     MalformedURLException: invalid port: -1（2026-09-14 真机实测）。
	     宿主必须提供 libp2p.so + com.p2p.P2PClass 并启动其 httpd，见 Platforms/Android/com/p2p/。

	     ⚠️ 许可与来源（用户明确知悉并选择打包）：
	     libp2p.so 取自 TVBox 参考仓库（AGPL-3.0）player/src/main/jniLibs/，
	     本体是荐片厂商的闭源二进制（无源码/头文件）。本项目 MIT，此项会进入发行物。
	     仅 arm64-v8a / armeabi-v7a 两个 ABI 存在（**上游没有 x86_64**），x86_64 设备无法使用荐片。

	     ⚠️ AndroidNativeLibrary 的 ABI 由**文件所在目录名**推导，不要改成扁平目录。 -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidNativeLibrary Include="Platforms\Android\jniLibs\arm64-v8a\libp2p.so" />
		<AndroidNativeLibrary Include="Platforms\Android\jniLibs\armeabi-v7a\libp2p.so" />
		<!-- 迅雷下载引擎：XLLoader 只加载这两个库（libplayer.so 是 ijkplayer，与本 SDK 无关，不要带）。
		     libxl_thunder_sdk.so → NEEDED libxl_stat.so，两个必须同包存在。
		     其余依赖（liblog/libz/libstdc++/libm/libc/libdl）都在 Android 公开库白名单里。 -->
		<AndroidNativeLibrary Include="Platforms\Android\jniLibs\arm64-v8a\libxl_thunder_sdk.so" />
		<AndroidNativeLibrary Include="Platforms\Android\jniLibs\armeabi-v7a\libxl_thunder_sdk.so" />
		<AndroidNativeLibrary Include="Platforms\Android\jniLibs\arm64-v8a\libxl_stat.so" />
		<AndroidNativeLibrary Include="Platforms\Android\jniLibs\armeabi-v7a\libxl_stat.so" />
	</ItemGroup>

	<!-- Android signing（同 CatClawMusic）：必须显式 AndroidKeyStore=true，且用 PropertyGroup 属性（非 ItemGroup）。
	     密码兜底内置（与 SIGNING.md 一致 catclaw123），命令行 -p:CatClawKeyPass=xxx 可覆盖。
	     keystore 位于仓库根目录 catclaw.keystore（PKCS12 / alias=catclaw / 有效期至 2054）。 -->
	<PropertyGroup>
		<CatClawKeyPass Condition="'$(CatClawKeyPass)' == ''">catclaw123</CatClawKeyPass>
		<CatClawStorePass Condition="'$(CatClawStorePass)' == ''">catclaw123</CatClawStorePass>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>..\catclaw.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>catclaw</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>$(CatClawKeyPass)</AndroidSigningKeyPass>
		<AndroidSigningStorePass>$(CatClawStorePass)</AndroidSigningStorePass>
		<!-- 启动闪退修复（同 CatClawMusic）：.NET Android 的 JNI Marshal Methods 在 Release
		     增量构建/多 ABI 场景下偶发 ACW 原生方法未注册，表现为
		     java.lang.UnsatisfiedLinkError: No implementation found for ... MauiApplication.n_onCreate()。
		     显式关闭，回退到传统 RegisterNatives 运行时注册路径。 -->
		<AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
	</PropertyGroup>

	<!-- 开发调试（Debug）：关闭 Fast Assembly Deployment，改用完整签名 APK 安装，部署更稳；
	     签名与 Release 用同一 catclaw.keystore，Debug/Release 交替安装时签名一致，
	     避免 JNIEnv::RegisterNatives 冲突（否则需清缓存/卸载重装）。 -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>..\catclaw.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>catclaw</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>$(CatClawKeyPass)</AndroidSigningKeyPass>
		<AndroidSigningStorePass>$(CatClawStorePass)</AndroidSigningStorePass>
	</PropertyGroup>

	<!-- Release 单 ABI 选择（同 CatClawMusic）：build-release.ps1 传 -p:ReleaseAbi=arm64。
	     在项目局部把 RuntimeIdentifiers 覆盖为单个 RID，让 AndroidSupportedAbis 自动派生为单一
	     ABI；不用命令行 -p:RuntimeIdentifiers（会级联到引用的 Core/Data 项目导致 MSB3030）。
	     不传 ReleaseAbi 时维持默认双 RID。 -->
	<Target Name="SelectReleaseAbi" BeforeTargets="_ResolveAndroidTooling" Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(DesignTimeBuild)' != 'true' And '$(ReleaseAbi)' != ''">
		<PropertyGroup Condition="'$(ReleaseAbi)' == 'arm64'">
			<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
		</PropertyGroup>
		<PropertyGroup Condition="'$(ReleaseAbi)' == 'x64'">
			<RuntimeIdentifiers>android-x64</RuntimeIdentifiers>
		</PropertyGroup>
	</Target>

	<!-- Windows XAML 编译修复（同 CatClawMusic）：App.generated.cs 仅 Release 参与编译（DISABLE_XAML_GENERATED_MAIN），
	     App.InitializeComponent.fallback.cs 默认排除，XamlCompiler 极端异常未产出 App.g.i.cs 时动态启用兜底。 -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<Compile Remove="Platforms\Windows\App.generated.cs" Condition="'$(Configuration)' == 'Debug'" />
		<Compile Remove="Platforms\Windows\App.InitializeComponent.fallback.cs" />
	</ItemGroup>

	<Target Name="EnsureAppInitializeComponent" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ItemGroup>
			<Compile Include="Platforms\Windows\App.InitializeComponent.fallback.cs" Condition="!Exists('$(XamlGeneratedOutputPath)Platforms\Windows\App.g.i.cs') And !Exists('$(XamlGeneratedOutputPath)Platforms\Windows\App.g.cs')" />
		</ItemGroup>
	</Target>

	<!-- QEMU 迅雷引擎运行时（Windows 专用）：随应用分发到 ThunderRuntime/。
	     引擎从 AppContext.BaseDirectory\ThunderRuntime 加载（见 Core/Services/QemuThunder）。
	     目录缺失时构建不报错，引擎判未就绪、磁力自动回落内置 BT。 -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<None Remove="ThunderRuntime\**" />
		<Content Include="ThunderRuntime\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- JavaBridge（jar 爬虫桥）：随应用分发到 JavaBridge/，让**安装版**也能找到桥
	     （JavaSpiderRuntime.FindBridgeDir 从 AppContext.BaseDirectory 逐级向上找 JavaBridge/bridge.jar）。

	     三块内容缺一不可：
	       · bridge.jar + vendor/deps —— 跑普通 jar 爬虫；
	       · vendor/dex2jar          —— 把 dex 转成 JVM 能加载的 jar（所有 csp_* 站点都要）；
	       · vendor/unidbg           —— Guard 加固包的解壳器（模拟 ARM64 跑原生解密 .so），
	                                    外加 unpacker.jar。缺它时 Guard 站点只能退回非 Guard 同族 jar，
	                                    而「荐片|多线」这类没有替代品的站点会直接不可用
	                                    （2026-09-19 用户实测安装版报「不可用 · unidbg 解壳失败且未找到
	                                     替代的非 Guard 同族 jar」）。
	     ⚠ 后两块共约 52MB（jar 已压缩，安装包难以再压），这是为「安装版片源与开发版一致」付的代价。 -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<Content Include="..\JavaBridge\bridge.jar">
			<Link>JavaBridge\bridge.jar</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\JavaBridge\vendor\deps\*.jar">
			<Link>JavaBridge\vendor\deps\%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\JavaBridge\vendor\dex2jar\*.jar">
			<Link>JavaBridge\vendor\dex2jar\%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\JavaBridge\vendor\unidbg\*.jar">
			<Link>JavaBridge\vendor\unidbg\%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<!-- ★ 第四块：**随包的精简 Java 运行时**（jlink 自 Microsoft OpenJDK 21，MIT 许可可再分发）。
		     此前 jar 类爬虫源要求用户自备 JDK 21——社区反馈里最常见的「显示需要 spider 运行」
		     根因就是它（2026-09-22 用户反馈「好像不行 显示需要spider运行」）。
		     随包后**开箱即用**，用户不再需要安装任何 Java。体积约 62MB，按用户要求接受。
		     ⚠ 必须整目录递归带上：jlink 产物有 bin/ conf/ legal/ lib/ 多级子目录。
		     ⚠ 扫描顺序：JavaSpiderRuntime.FindJavaExe 会**优先**用这份，见其注释。 -->
		<Content Include="..\JavaBridge\jre\**\*">
			<Link>JavaBridge\jre\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
